{
  "name": "ssh-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build:web": "vite build --config apps/console/vite.config.ts",
    "dev:web": "vite --config apps/console/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply ssh-manager-staging --config wrangler.single.staging.local.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply ssh-manager-staging --config wrangler.single.staging.local.jsonc --remote",
    "test:agent": "cd agent && go test ./...",
    "test": "vitest run",
    "cf:quick": "node scripts/cloudflare_quick_deploy.mjs",
    "cf:quick:dry": "node scripts/cloudflare_quick_deploy.mjs --dry-run",
    "test:cf:quick": "node --test scripts/test_cloudflare_quick_deploy.mjs",
    "deploy:single": "wrangler deploy --config wrangler.single.staging.local.jsonc"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.45.0",
    "vitest": "^3.2.4"
  }
}
